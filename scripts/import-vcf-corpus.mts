/**
 * Imports the planning data the compatibility checker uses from the VCF 9.1 TechDocs corpus (the folder the
 * vcf-corpus-refresh skill maintains): CPU series and the releases each is listed for, the KB 318697 CPU lifecycle,
 * ESX builds and release dates, the KB planning rules, and partner server statements that conflict with Broadcom.
 *
 *   pnpm corpus:import "/path/to/VCF 9.1 TechDocs"
 *
 * Writes shared/vcfCorpus.ts. Run it after each weekly refresh and commit the result with the tests.
 */
import { readFileSync, writeFileSync } from "node:fs";
import path from "node:path";

const dir = process.argv[2];
if (!dir) throw new Error("Pass the corpus folder, for example: pnpm corpus:import \"$HOME/Downloads/VCF 9.1 TechDocs\"");
const read = (name: string) => JSON.parse(readFileSync(path.join(dir, name), "utf8"));

type Packed = { s: string[]; p: number[][][]; d: Record<string, { c: unknown; r: unknown[][] }>; src: string; exp: string; cpu_lifecycle: { source: string; url: string; retrieved: string; rows: Array<Record<string, string>> }; kb: Array<Record<string, unknown>> };
const packed = read("hcl-full-packed.json") as Packed;
const strings = packed.s;
const decode = (value: unknown): unknown => (typeof value === "number" ? strings[value] : Array.isArray(value) ? value.map(decode) : value);

// CPU series: the name and every ESXi release the Compatibility Guide lists it for.
const cpuSeries = packed.d.cpu.r.map(row => {
  const fields = decode(row[0]) as unknown[];
  const name = Array.isArray(fields[0]) ? (fields[0] as string[]).join(", ") : String(fields[0]);
  const releases = typeof row[1] === "number" ? (decode(packed.p[row[1]]) as string[][]).map(item => item[0]) : [];
  return [name, releases] as const;
});

// KB 318697 lifecycle for VCF 9.x: Deprecated still runs, Discontinued is blocked by the installer.
const lifecycle = packed.cpu_lifecycle.rows.map(row => ({
  series: row.series,
  codeName: row.code_name,
  vcf9x: /^discontinued/i.test(row.vcf9x) ? "discontinued" : /428874/.test(row.vcf9x) ? "deprecated-override" : /^deprecated/i.test(row.vcf9x) ? "deprecated" : "supported",
  nextMajor: row.next_major,
}));

const releases = (read("releases.json") as { releases: Array<Record<string, string>> }).releases
  .filter(item => /^esx/i.test(item.product ?? ""))
  .map(item => ({ version: item.version, build: Number(item.build), releaseDate: item.release_date }))
  .filter(item => item.build > 0)
  .sort((left, right) => left.build - right.build);

const kb = packed.kb.map(item => ({ id: String(item.id), title: String(item.title), url: String(item.url), updated: String(item.updated ?? ""), publisher: String(item.publisher ?? "Broadcom"), planningRule: String(item.planning_rule ?? "") }));

// Partner statements about servers that stop short of what Broadcom says (Broadcom governs; these become advisories).
const vendor = read("vendor-compat.json") as { documents: Array<{ vendor?: string; publisher?: string; entries?: Array<Record<string, string>> }> };
const vendorNotes = vendor.documents.flatMap(document => (document.entries ?? [])
  .filter(entry => entry.component === "server" && /confirm with vendor|not supported/i.test(entry.status ?? ""))
  .map(entry => ({ vendor: String(document.vendor ?? document.publisher ?? ""), platform: entry.platform, release: entry.esx_or_vcf_version, status: entry.status, notes: entry.notes })));

const changelog = readFileSync(path.join(dir, "CHANGELOG.md"), "utf8");
const refreshed = changelog.match(/^## (\d{4}-\d{2}-\d{2})/m)?.[1] ?? "";

const out = `/**
 * Generated by scripts/import-vcf-corpus.mts from the VCF 9.1 TechDocs corpus; do not edit by hand.
 * ${packed.src}
 */
export const VCF_CORPUS = ${JSON.stringify({ refreshed, compatibilityGuide: packed.exp, cpuLifecycleSource: packed.cpu_lifecycle.source, cpuLifecycleUrl: packed.cpu_lifecycle.url, kbCount: kb.length }, null, 2)} as const;

/** CPU series and the ESXi releases the Compatibility Guide lists each for. */
export const CPU_SERIES_RELEASES: ReadonlyArray<readonly [string, readonly string[]]> = ${JSON.stringify(cpuSeries)};

export type CpuLifecycleStatus = "supported" | "deprecated" | "deprecated-override" | "discontinued";
/** KB 318697 (with KB 428874 for Skylake-SP): CPU support in VCF 9.x and the next major release. */
export const CPU_LIFECYCLE: ReadonlyArray<{ series: string; codeName: string; vcf9x: CpuLifecycleStatus; nextMajor: string }> = ${JSON.stringify(lifecycle, null, 1)};

/** ESX releases and patches with build numbers and release dates, oldest build first. */
export const ESX_BUILDS: ReadonlyArray<{ version: string; build: number; releaseDate: string }> = ${JSON.stringify(releases, null, 1)};

export const VCF_KB: ReadonlyArray<{ id: string; title: string; url: string; updated: string; publisher: string; planningRule: string }> = ${JSON.stringify(kb, null, 1)};

/** Partner server statements that conflict with or stop short of Broadcom's; Broadcom governs. */
export const VENDOR_SERVER_NOTES: ReadonlyArray<{ vendor: string; platform: string; release: string; status: string; notes: string }> = ${JSON.stringify(vendorNotes, null, 1)};
`;
writeFileSync(path.join(import.meta.dirname, "..", "shared", "vcfCorpus.ts"), out);
console.log(`Wrote shared/vcfCorpus.ts: ${cpuSeries.length} CPU series, ${lifecycle.length} lifecycle rows, ${releases.length} ESX builds, ${kb.length} KBs, ${vendorNotes.length} vendor notes (corpus ${refreshed}).`);
